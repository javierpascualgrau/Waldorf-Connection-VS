{
  "name": "Post",
  "type": "object",
  "properties": {
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_role": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "taller",
        "evento_espiritual",
        "educacion",
        "arte",
        "carpinteria",
        "musica",
        "teatro",
        "naturaleza",
        "profesor_particular",
        "asociacion",
        "otro"
      ],
      "default": "otro"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "comments_count": {
      "type": "number",
      "default": 0
    },
    "location": {
      "type": "string"
    },
    "event_date": {
      "type": "string"
    },
    "is_service_offer": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "author_email",
    "content",
    "category"
  ]
}